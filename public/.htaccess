# ----------------------------------------------------------------------
# 1. KEAMANAN & HTTPS ENFORCEMENT
# ----------------------------------------------------------------------
RewriteEngine On
RewriteBase /

# Paksa HTTPS jika diakses via HTTP port 80
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----------------------------------------------------------------------
# 2. CANONICAL DOMAIN REDIRECT
# Jika diakses lewat URL hosting sementara (*.apitowp.com)
# otomatis lempar ke domain utama pijatpanggilanpalembang.web.id
# ----------------------------------------------------------------------
RewriteCond %{HTTP_HOST} \.apitowp\.com$ [NC]
RewriteRule ^(.*)$ https://pijatpanggilanpalembang.web.id/$1 [L,R=301]

# ----------------------------------------------------------------------
# 3. ROUTING & CLEAN URLS (Astro Static SSG Support)
# Membuka /layanan/pijat-refleksi -> /layanan/pijat-refleksi/index.html
# ----------------------------------------------------------------------
# Jika file atau direktori fisik ada, langsung sajikan
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Coba sajikan file .html jika request tanpa ekstensi
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Sajikan index.html di dalam subfolder
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)/?$ $1/index.html [L]

# ----------------------------------------------------------------------
# 4. KOMPRESI GZIP & BROTLI (LiteSpeed / Apache)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 5. BROWSER CACHING (Header Expires untuk Skor PageSpeed Tinggi)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Gambar, WebP, SVG, Favicon
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # HTML & Data (singkat agar update konten cepat terlihat)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# 6. HEADER KEAMANAN TAMBAHAN
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Sembunyikan file sensitif
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
