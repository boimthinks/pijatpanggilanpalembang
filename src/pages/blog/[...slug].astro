---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TOC from '../../components/TOC.astro';
import GoogleSourcePreferences from '../../components/GoogleSourcePreferences.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const siteUrl = 'https://pijatpanggilanpalembang.web.id';
const postUrl = `${siteUrl}/blog/${post.id}/`;

// Structured Data: Article + Breadcrumb + FAQPage
const blogSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    image: `${siteUrl}${post.data.image}`,
    datePublished: post.data.publishDate.toISOString(),
    author: {
      '@type': 'Organization',
      name: post.data.author,
      url: siteUrl,
    },
    publisher: {
      '@type': 'HealthAndBeautyBusiness',
      name: 'Sriwijaya Massage Palembang',
      logo: `${siteUrl}/images/og-image.webp`,
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': postUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Beranda',
        item: siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: `${siteUrl}/blog/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.data.title,
        item: postUrl,
      },
    ],
  },
  ...(post.data.faq && post.data.faq.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: post.data.faq.map((f) => ({
            '@type': 'Question',
            name: f.question,
            acceptedAnswer: {
              '@type': 'Answer',
              text: f.answer,
            },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={`${post.data.title} | Sriwijaya Massage Palembang`}
  description={post.data.description}
  image={post.data.image}
  canonicalUrl={postUrl}
  type="article"
  schema={blogSchema}
>
  <!-- Breadcrumb Bar -->
  <div class="bg-gray-100 border-b border-gray-200 py-3 text-xs text-gray-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2">
        <a href="/" class="hover:text-orange-600">Beranda</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-orange-600">Blog</a>
        <span>/</span>
        <span class="text-gray-900 font-semibold truncate">{post.data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Article Header -->
  <header class="bg-gradient-to-b from-orange-950 via-orange-900 to-gray-900 text-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 bg-orange-800 text-orange-200 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
        <span>{post.data.category}</span>
      </div>
      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
        {post.data.title}
      </h1>
      <div class="flex items-center gap-4 text-xs text-orange-200 pt-2">
        <span>Ditulis oleh: <strong>{post.data.author}</strong></span>
        <span>•</span>
        <span>{post.data.publishDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      </div>
    </div>
  </header>

  <!-- 2-COLUMN ARTICLE LAYOUT -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- MAIN ARTICLE CONTENT (Col 8) -->
      <main class="lg:col-span-8 space-y-8">
        
        <!-- Featured Image 4:3 (800x600 WebP) -->
        <div class="aspect-4-3 bg-gray-100 rounded-2xl overflow-hidden border border-gray-200 shadow-sm">
          <img
            src={post.data.image}
            alt={post.data.title}
            width="800"
            height="600"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>

        <!-- Markdown Body -->
        <article class="markdown-content text-gray-800 leading-relaxed text-base">
          <Content />
        </article>

        <!-- FAQ Section If Present -->
        {post.data.faq && post.data.faq.length > 0 && (
          <section class="mt-12 pt-8 border-t border-gray-200 space-y-4">
            <h2 class="text-2xl font-bold text-gray-900">Pertanyaan yang Sering Diajukan (FAQ)</h2>
            <div class="space-y-3">
              {post.data.faq.map((f) => (
                <div class="p-5 bg-white border border-gray-200 rounded-xl space-y-1">
                  <h3 class="font-bold text-sm text-gray-900">{f.question}</h3>
                  <p class="text-xs text-gray-600 leading-relaxed mt-1">{f.answer}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <GoogleSourcePreferences />

        <!-- Silo Money Page Links Navigation -->
        <div class="p-6 bg-orange-50 rounded-2xl border border-orange-200 mt-8 space-y-3">
          <h3 class="font-bold text-orange-950 text-sm">Butuh Pijat Panggilan Segera di Palembang?</h3>
          <p class="text-xs text-orange-900 leading-relaxed">
            Pesan terapis berlisensi BNSP kami untuk panggilan ke rumah, kos, apartemen, atau hotel Anda tanpa uang muka (tanpa DP) dan gratis biaya perjalanan:
          </p>
          <div class="flex flex-wrap gap-2 pt-1">
            <a href="/layanan/pijat-tradisional/" class="text-xs bg-white text-orange-800 font-bold px-3 py-1.5 rounded-lg border border-orange-300 hover:bg-orange-600 hover:text-white transition-colors">
              Pijat Tradisional Full Body
            </a>
            <a href="/layanan/pijat-panggilan-hotel-24-jam/" class="text-xs bg-white text-orange-800 font-bold px-3 py-1.5 rounded-lg border border-orange-300 hover:bg-orange-600 hover:text-white transition-colors">
              Pijat Hotel On-Call 24 Jam
            </a>
            <a href="/layanan/pijat-panggilan-ke-rumah/" class="text-xs bg-white text-orange-800 font-bold px-3 py-1.5 rounded-lg border border-orange-300 hover:bg-orange-600 hover:text-white transition-colors">
              Home Service Bawa Matras
            </a>
          </div>
        </div>

      </main>

      <!-- STICKY SIDEBAR (Col 4) -->
      <aside class="lg:col-span-4 sticky top-24 space-y-6">
        
        <!-- Table of Contents Component -->
        <TOC headings={headings} />

        <!-- Booking CTA Card -->
        <div class="bg-gradient-to-br from-orange-950 to-gray-900 text-white p-6 rounded-2xl shadow-xl space-y-4 border border-orange-700/50">
          <span class="inline-block bg-orange-500 text-white font-black text-[10px] uppercase px-2.5 py-0.5 rounded-full">
            Online 24 Jam
          </span>
          <h3 class="text-lg font-bold text-white tracking-tight">Butuh Terapis Sekarang?</h3>
          <p class="text-xs text-orange-200">
            Terapis terdekat di Palembang siap meluncur ke hotel atau rumah Anda dalam 30–45 menit.
          </p>

          <a
            href="/booking/"
            class="w-full flex items-center justify-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-extrabold text-xs py-3 rounded-xl shadow transition-transform hover:scale-105"
          >
            <span>Isi Form Booking Online</span>
          </a>
        </div>

        <!-- Keunggulan Singkat -->
        <div class="bg-white p-5 rounded-2xl border border-gray-200 text-xs space-y-2">
          <h4 class="font-bold text-gray-900 uppercase tracking-wide">Standar Kami</h4>
          <p class="text-gray-600 text-[11px] leading-relaxed">
            Sriwijaya Massage Palembang adalah penyedia resmi berizin STPT Dinkes. Seluruh sesi terapi mengutamakan kebugaran keluarga dan bebas dari segala bentuk asusila.
          </p>
        </div>

      </aside>

    </div>
  </div>
</BaseLayout>
