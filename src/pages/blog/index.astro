---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const pageTitle = "Blog & Panduan Kebugaran Pijat Palembang 2026";
const pageDesc = "Kumpulan artikel edukasi kebugaran, panduan tarif resmi, tips memilih terapis panggilan aman, dan info terapi fisik di Kota Palembang.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <!-- Header Section -->
  <section class="bg-gradient-to-b from-orange-950 via-orange-900 to-gray-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 bg-orange-800 text-orange-200 text-xs font-bold uppercase tracking-widest rounded-full">
        Pusat Edukasi Kebugaran
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        Blog & Panduan Terapi Fisik Palembang
      </h1>
      <p class="text-base sm:text-lg text-orange-100 max-w-2xl mx-auto leading-relaxed">
        Informasi terpercaya seputar kesehatan otot, panduan tarif transparan, dan tips memilih jasa pijat panggilan keluarga yang aman dan bersertifikat di Palembang.
      </p>
    </div>
  </section>

  <!-- Post Grid (Rasio 4:3) -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <article class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
            <!-- 4:3 Image Container (Clickable) -->
            <a href={`/blog/${post.id}/`} class="aspect-4-3 bg-gray-100 overflow-hidden relative block group-hover:opacity-95 transition-opacity" aria-label={`Baca artikel ${post.data.title}`}>
              <img
                src={post.data.image}
                alt={post.data.title}
                width="800"
                height="600"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 bg-gray-900/80 backdrop-blur-sm text-orange-400 text-[11px] font-bold px-2.5 py-1 rounded-md">
                {post.data.category}
              </span>
            </a>

            <!-- Content Container -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <div class="text-xs text-gray-400 mb-2">
                  {post.data.publishDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
                </div>
                <h2 class="text-lg sm:text-xl font-bold text-gray-900 group-hover:text-orange-600 transition-colors leading-snug">
                  <a href={`/blog/${post.id}/`}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-sm text-gray-600 mt-2 line-clamp-3 leading-relaxed">
                  {post.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                <span class="text-xs font-semibold text-orange-600 group-hover:underline flex items-center gap-1">
                  Baca Selengkapnya →
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
