---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleSourcePreferences from '../components/GoogleSourcePreferences.astro';

const pageTitle = "Daftar Tarif Pijat Panggilan Palembang 2026 | All-in Bebas Ongkir";
const pageDesc = "Rincian harga dan tarif pijat panggilan ke hotel dan rumah di Palembang. Transparan per 60, 90, 120 menit tanpa DP dan gratis ongkos transportasi.";
const pageUrl = "https://pijatpanggilanpalembang.web.id/tarif/";
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={pageUrl}
>
  <div class="bg-gray-100 border-b border-gray-200 py-3 text-xs text-gray-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/" class="hover:text-orange-600">Beranda</a>
      <span>/</span>
      <span class="text-gray-900 font-semibold">Tarif Resmi</span>
    </div>
  </div>

  <header class="bg-gradient-to-b from-orange-950 via-orange-900 to-gray-900 text-white py-16 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <span class="inline-block bg-orange-800 text-orange-200 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
        Transparan & Tanpa Biaya Tersembunyi
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
        Daftar Tarif Pijat Panggilan Palembang
      </h1>
      <p class="text-base sm:text-lg text-orange-100 max-w-2xl mx-auto leading-relaxed">
        Seluruh tarif bersifat all-in: sudah termasuk jasa terapis bersertifikat BNSP, bahan minyak aromaterapi/lulur, dan ongkos perjalanan ke seluruh wilayah Palembang.
      </p>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    
    <!-- 3 KARTU TARIF UTAMA -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Paket Standar 60 Menit -->
      <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm flex flex-col justify-between">
        <div class="space-y-4">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">Durasi Singkat</span>
          <h2 class="text-2xl font-bold text-gray-900">Relaksasi 60 Menit</h2>
          <div class="my-4">
            <span class="text-3xl font-black text-orange-800">Rp 150.000</span>
            <span class="text-xs text-gray-500 block mt-1">Khusus Panggilan Rumah & Kos</span>
          </div>
          <p class="text-xs text-gray-600 leading-relaxed">
            Pilihan tepat untuk peregangan cepat setelah lelah bekerja harian atau fokus mengatasi nyeri leher dan pundak kaku.
          </p>
          <ul class="space-y-2 text-xs text-gray-700 pt-2 border-t border-gray-100">
            <li class="flex items-center gap-2">✓ Urut punggung, leher, dan bahu</li>
            <li class="flex items-center gap-2">✓ Minyak aromaterapi zaitun alami</li>
            <li class="flex items-center gap-2">✓ Gratis ongkir dalam kota</li>
          </ul>
        </div>
        <div class="pt-6">
          <a
            href="/booking/"
            class="w-full inline-flex items-center justify-center bg-gray-100 hover:bg-orange-600 hover:text-white text-gray-900 font-bold text-xs py-3 rounded-xl transition-colors"
          >
            Isi Form Booking
          </a>
        </div>
      </div>

      <!-- Paket Favorit 90 Menit -->
      <div class="bg-orange-50/50 rounded-2xl border-2 border-orange-500 p-8 shadow-md flex flex-col justify-between relative">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-orange-600 text-white text-[11px] font-extrabold uppercase px-3 py-0.5 rounded-full">
          Paling Direkomendasikan
        </div>
        <div class="space-y-4">
          <span class="text-xs font-bold text-orange-700 uppercase tracking-widest">Durasi Optimal</span>
          <h2 class="text-2xl font-bold text-gray-900">Full Body 90 Menit</h2>
          <div class="my-4">
            <span class="text-3xl font-black text-orange-800">Rp 200.000</span>
            <span class="text-xs text-gray-500 block mt-1">Rumah (Rp 200rb) / Hotel On-Call (Rp 250rb)</span>
          </div>
          <p class="text-xs text-gray-600 leading-relaxed">
            Waktu paling ideal bagi terapis untuk mengurai seluruh simpul ketegangan otot dari ujung kepala hingga telapak kaki secara merata.
          </p>
          <ul class="space-y-2 text-xs text-gray-700 pt-2 border-t border-orange-100">
            <li class="flex items-center gap-2">✓ Pijat tradisional seluruh tubuh menyeluruh</li>
            <li class="flex items-center gap-2">✓ Pelemasan otot pinggang dan panggul</li>
            <li class="flex items-center gap-2">✓ Pijat telapak kaki pemulihan stamina</li>
            <li class="flex items-center gap-2">✓ Bebas ongkir & tanpa DP</li>
          </ul>
        </div>
        <div class="pt-6">
          <a
            href="/booking/"
            class="w-full inline-flex items-center justify-center bg-orange-600 hover:bg-orange-700 text-white font-bold text-xs py-3.5 rounded-xl shadow transition-colors"
          >
            Isi Form Booking
          </a>
        </div>
      </div>

      <!-- Paket Komplit 120 Menit -->
      <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm flex flex-col justify-between">
        <div class="space-y-4">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">Durasi Paripurna</span>
          <h2 class="text-2xl font-bold text-gray-900">Komplit 120 Menit</h2>
          <div class="my-4">
            <span class="text-3xl font-black text-orange-800">Rp 250.000 - Rp 280.000</span>
            <span class="text-xs text-gray-500 block mt-1">Termasuk Pilihan Kombo Spa</span>
          </div>
          <p class="text-xs text-gray-600 leading-relaxed">
            Kombinasi komplit full body massage 90 menit ditambah terapi pendukung (kerokan higienis, totok wajah, atau lulur scrub).
          </p>
          <ul class="space-y-2 text-xs text-gray-700 pt-2 border-t border-gray-100">
            <li class="flex items-center gap-2">✓ Full body deep traditional massage</li>
            <li class="flex items-center gap-2">✓ Pilihan: Kerokan / Totok Wajah / Scrub</li>
            <li class="flex items-center gap-2">✓ Relaksasi total sebelum tidur lelap</li>
          </ul>
        </div>
        <div class="pt-6">
          <a
            href="/booking/"
            class="w-full inline-flex items-center justify-center bg-gray-100 hover:bg-orange-600 hover:text-white text-gray-900 font-bold text-xs py-3 rounded-xl transition-colors"
          >
            Isi Form Booking
          </a>
        </div>
      </div>

    </section>

    <!-- TABEL LENGKAP DAFTAR HARGA -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-gray-900">Tabel Rincian Seluruh Menu Layanan</h2>
      <div class="overflow-x-auto border border-gray-200 rounded-2xl bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-gray-50 border-b border-gray-200 text-xs text-gray-700 uppercase">
            <tr>
              <th class="py-4 px-6">Nama Layanan</th>
              <th class="py-4 px-6">Pilihan Durasi</th>
              <th class="py-4 px-6">Tarif Resmi</th>
              <th class="py-4 px-6">Keterangan Fasilitas</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 text-xs text-gray-600">
            <tr class="hover:bg-gray-50">
              <td class="py-4 px-6 font-bold text-gray-900">Pijat Tradisional & Urut Nusantara</td>
              <td class="py-4 px-6">60 / 90 / 120 Menit</td>
              <td class="py-4 px-6 font-semibold text-orange-700">Rp 150rb / Rp 200rb / Rp 250rb</td>
              <td class="py-4 px-6">Meredakan capek, pegal linu, dan masuk angin</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-4 px-6 font-bold text-gray-900">Pijat Refleksi Kaki & Dry Massage</td>
              <td class="py-4 px-6">60 / 90 Menit</td>
              <td class="py-4 px-6 font-semibold text-orange-700">Rp 140rb / Rp 190rb</td>
              <td class="py-4 px-6">Tanpa minyak lengket, stimulasi titik saraf akupresur</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-4 px-6 font-bold text-gray-900">Home Service VIP (Bawa Matras Lipat)</td>
              <td class="py-4 px-6">90 / 120 Menit</td>
              <td class="py-4 px-6 font-semibold text-orange-700">Rp 240rb / Rp 270rb</td>
              <td class="py-4 px-6">Termasuk matras busa tebal & sprei disposable sekali pakai</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-4 px-6 font-bold text-gray-900">Pijat Hotel On-Call Siaga 24 Jam</td>
              <td class="py-4 px-6">60 / 90 / 120 Menit</td>
              <td class="py-4 px-6 font-semibold text-orange-700">Rp 200rb / Rp 250rb / Rp 300rb</td>
              <td class="py-4 px-6">Standby cepat tiba 30-45 menit di kamar hotel bintang</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-4 px-6 font-bold text-gray-900">Kombo Pijat + Kerokan Higienis</td>
              <td class="py-4 px-6">90 Menit</td>
              <td class="py-4 px-6 font-semibold text-orange-700">Rp 220.000</td>
              <td class="py-4 px-6">Full body massage + koin steril minyak kayu putih</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-4 px-6 font-bold text-gray-900">Kombo Pijat + Lulur Body Scrub</td>
              <td class="py-4 px-6">120 Menit</td>
              <td class="py-4 px-6 font-semibold text-orange-700">Rp 260.000</td>
              <td class="py-4 px-6">Eksfoliasi sel kulit mati dengan scrub zaitun Mustika Ratu</td>
            </tr>
            <tr class="hover:bg-gray-50">
              <td class="py-4 px-6 font-bold text-gray-900">Paket Group Massage Keluarga (2 Orang)</td>
              <td class="py-4 px-6">120 Menit (2x 60 Menit)</td>
              <td class="py-4 px-6 font-semibold text-orange-700">Rp 280.000</td>
              <td class="py-4 px-6">1 Terapis melayani 2 orang anggota keluarga bergantian</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- KEBIJAKAN PEMBAYARAN -->
    <section class="bg-gray-100 rounded-2xl p-8 space-y-4">
      <h3 class="font-bold text-gray-900 text-lg">Kebijakan Pembayaran Transparan (Tanpa Tip Paksaan)</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-gray-700">
        <div>
          <strong class="text-orange-800 block text-sm mb-1">1. Sistem Tanpa DP</strong>
          Anda tidak perlu mentransfer uang sepeser pun di muka. Pembayaran baru diserahkan setelah terapis menyelesaikan sesi terapi di lokasi Anda.
        </div>
        <div>
          <strong class="text-orange-800 block text-sm mb-1">2. Pilihan Pembayaran Fleksibel</strong>
          Terapis kami dapat menerima uang tunai (cash), transfer antarbank real-time, atau pembayaran non-tunai melalui QRIS dinamis.
        </div>
        <div>
          <strong class="text-orange-800 block text-sm mb-1">3. Tanpa Uang Tip Paksaan</strong>
          Tarif yang tercantum adalah tarif final. Memberi uang tip kepada terapis sepenuhnya merupakan hak sukarela dari Anda atas kepuasan pelayanan.
        </div>
      </div>
    </section>

    <GoogleSourcePreferences />
  </div>
</BaseLayout>
