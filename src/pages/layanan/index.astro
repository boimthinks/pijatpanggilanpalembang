---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { servicesData } from '../../data/services';

const pageTitle = "Layanan Pijat Panggilan & Urut Tradisional Palembang 24 Jam";
const pageDesc = "Daftar lengkap layanan pijat tradisional, refleksi, home service bawa matras, panggilan hotel 24 jam, dan lulur kerokan di Palembang. Bersertifikat BNSP.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <!-- Header Banner -->
  <section class="bg-gradient-to-b from-orange-950 via-orange-900 to-gray-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 bg-orange-800 text-orange-200 text-xs font-bold uppercase tracking-widest rounded-full">
        Menu Perawatan & Kebugaran
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        Layanan Pijat Panggilan Palembang
      </h1>
      <p class="text-base sm:text-lg text-orange-100 max-w-2xl mx-auto leading-relaxed">
        Pilihan modalitas terapi fisik dan relaksasi tubuh yang ditangani langsung oleh terapis profesional ke rumah, hotel, apartemen, atau indekos Anda.
      </p>
    </div>
  </section>

  <!-- Service List (4:3 Cards) -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {servicesData.map((service) => (
          <article class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
            <a href={`/layanan/${service.slug}/`} class="aspect-4-3 bg-gray-100 overflow-hidden relative block group-hover:opacity-95 transition-opacity" aria-label={`Lihat layanan ${service.title}`}>
              <img
                src={service.heroImage}
                alt={service.title}
                width="800"
                height="600"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 bg-gray-900/80 backdrop-blur-sm text-orange-400 text-[11px] font-bold px-2.5 py-1 rounded-md">
                Tersedia 24 Jam
              </span>
            </a>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <h2 class="text-xl font-bold text-gray-900 group-hover:text-orange-600 transition-colors">
                  <a href={`/layanan/${service.slug}/`}>
                    {service.title}
                  </a>
                </h2>
                <p class="text-sm text-gray-600 mt-2 line-clamp-3 leading-relaxed">
                  {service.shortDesc}
                </p>
              </div>

              <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                <div>
                  <span class="text-xs text-gray-500 block">Tarif Mulai:</span>
                  <span class="text-base font-extrabold text-orange-700">{service.packages[0]?.price}</span>
                </div>
                <a
                  href={`/layanan/${service.slug}/`}
                  class="inline-flex items-center gap-1.5 bg-orange-600 hover:bg-orange-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition-colors"
                >
                  <span>Detail Layanan</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
