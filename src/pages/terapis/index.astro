---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Terapis Pijat Panggilan Palembang | Pilihan Terapis Pria & Wanita";
const pageDesc = "Pilih terapis pijat panggilan profesional di Palembang. Terapis pria untuk tekanan kuat dan terapis wanita khusus kenyamanan keluarga & syar'i.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <section class="bg-gradient-to-b from-orange-950 via-orange-900 to-gray-900 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 bg-orange-800 text-orange-200 text-xs font-bold uppercase tracking-widest rounded-full">
        Preferensi & Kenyamanan Gender
      </span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        Terapis Pijat Panggilan Palembang
      </h1>
      <p class="text-base sm:text-lg text-orange-100 max-w-2xl mx-auto leading-relaxed">
        Kami menghormati norma kesopanan dan preferensi kenyamanan Anda dengan menyediakan divisi terapis pria dan terapis wanita bersertifikat BNSP.
      </p>
    </div>
  </section>

  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Hub Card: Terapis Pria -->
        <article class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
          <a href="/terapis/pria/" class="aspect-4-3 bg-gray-100 overflow-hidden relative block group-hover:opacity-95 transition-opacity" aria-label="Lihat Layanan Terapis Pria">
            <img
              src="/images/terapis-pria.webp"
              alt="Layanan Terapis Pria Profesional Palembang"
              width="800"
              height="600"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 bg-slate-900/90 text-orange-400 text-xs font-bold px-3 py-1 rounded-md">
              Tekanan Bertenaga & Deep Tissue
            </span>
          </a>

          <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <h2 class="text-2xl font-bold text-gray-900 group-hover:text-orange-600 transition-colors">
                <a href="/terapis/pria/">Layanan Terapis Pria</a>
              </h2>
              <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                Dirancang khusus bagi pekerja lapangan, pengemudi, atlet, dan pria yang membutuhkan tenaga pijatan kuat untuk mengatasi kaku otot punggung, pegal pinggang bawah, dan cedera kelelahan kerja.
              </p>
              <ul class="mt-4 space-y-2 text-xs text-gray-700">
                <li class="flex items-center gap-2">✓ Tekanan kuat stabil untuk otot tebal</li>
                <li class="flex items-center gap-2">✓ Menguasai manipulasi trigger point pinggang</li>
                <li class="flex items-center gap-2">✓ Siaga on-call 24 jam ke hotel & rumah</li>
              </ul>
            </div>

            <div class="pt-4 border-t border-gray-100">
              <a
                href="/terapis/pria/"
                class="w-full inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm py-3 rounded-xl transition-colors"
              >
                <span>Lihat Profil & Layanan Terapis Pria →</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Hub Card: Terapis Wanita -->
        <article class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
          <a href="/terapis/wanita/" class="aspect-4-3 bg-gray-100 overflow-hidden relative block group-hover:opacity-95 transition-opacity" aria-label="Lihat Layanan Terapis Wanita">
            <img
              src="/images/terapis-wanita.webp"
              alt="Layanan Terapis Wanita Ramah & Aman Palembang"
              width="800"
              height="600"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 bg-rose-950/90 text-pink-300 text-xs font-bold px-3 py-1 rounded-md">
              100% Khusus Pelanggan Wanita (Syar'i)
            </span>
          </a>

          <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <h2 class="text-2xl font-bold text-gray-900 group-hover:text-pink-700 transition-colors">
                <a href="/terapis/wanita/">Layanan Terapis Wanita</a>
              </h2>
              <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                Jaminan rasa aman, privasi utuh, dan kenyamanan tertinggi untuk ibu rumah tangga, mahasiswi, wanita karier, dan muslimah. Etika santun, ramah, dan higienis.
              </p>
              <ul class="mt-4 space-y-2 text-xs text-gray-700">
                <li class="flex items-center gap-2">✓ Khusus pelanggan perempuan (Privasi terjaga)</li>
                <li class="flex items-center gap-2">✓ Ahli perawatan lulur body scrub & totok wajah</li>
                <li class="flex items-center gap-2">✓ Terapis ramah, sopan, dan berseragam rapi</li>
              </ul>
            </div>

            <div class="pt-4 border-t border-gray-100">
              <a
                href="/terapis/wanita/"
                class="w-full inline-flex items-center justify-center gap-2 bg-rose-900 hover:bg-rose-800 text-white font-bold text-sm py-3 rounded-xl transition-colors"
              >
                <span>Lihat Profil & Layanan Terapis Wanita →</span>
              </a>
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>
</BaseLayout>
