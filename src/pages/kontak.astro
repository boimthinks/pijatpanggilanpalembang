---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleSourcePreferences from '../components/GoogleSourcePreferences.astro';

const pageTitle = "Kontak Pemesanan Pijat Panggilan Palembang 24 Jam | Sriwijaya Massage";
const pageDesc = "Hubungi layanan reservasi Sriwijaya Massage Palembang. Pesan terapis online atau hubungi customer service 24 jam dengan respon cepat.";
const pageUrl = "https://pijatpanggilanpalembang.web.id/kontak/";
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={pageUrl}
>
  <div class="bg-gray-100 border-b border-gray-200 py-3 text-xs text-gray-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/" class="hover:text-orange-600">Beranda</a>
      <span>/</span>
      <span class="text-gray-900 font-semibold">Kontak</span>
    </div>
  </div>

  <header class="bg-gradient-to-b from-orange-950 via-orange-900 to-gray-900 text-white py-16 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <span class="inline-block bg-orange-800 text-orange-200 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
        Pusat Bantuan & Reservasi 24 Jam
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
        Hubungi Pemesanan Terapis
      </h1>
      <p class="text-base sm:text-lg text-orange-100 max-w-2xl mx-auto leading-relaxed">
        Koordinator reservasi kami siaga 24 jam penuh untuk mengonfirmasi ketersediaan armada terapis terdekat di hotel maupun kediaman Anda di Palembang.
      </p>
    </div>
  </header>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
      
      <!-- Contact Info Box -->
      <div class="space-y-6">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Saluran Komunikasi Resmi</h2>
          <p class="text-sm text-gray-600 mt-1 leading-relaxed">
            Untuk kemudahan dan pencatatan reservasi otomatis, Anda dapat mengisi formulir booking online atau menghubungi tim kami melalui saluran di bawah ini.
          </p>
        </div>

        <div class="p-6 bg-white border border-gray-200 rounded-2xl shadow-sm space-y-4">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs text-gray-400 font-semibold uppercase">Hotline Layanan 24 Jam</span>
              <a href="https://wa.me/6281278901234" target="_blank" rel="noopener noreferrer" class="text-lg font-black text-orange-600 hover:underline">
                0812-7890-1234
              </a>
              <p class="text-xs text-gray-500 mt-0.5">Respon cepat rata-rata dalam 3-5 menit</p>
            </div>
          </div>

          <div class="flex items-start gap-4 pt-4 border-t border-gray-100">
            <div class="w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs text-gray-400 font-semibold uppercase">Alamat Hub Operasional</span>
              <p class="text-sm font-bold text-gray-900">Jl. Jenderal Sudirman No. 128</p>
              <p class="text-xs text-gray-600 mt-0.5">Sekip Jaya, Kec. Kemuning, Kota Palembang 30128</p>
            </div>
          </div>

          <div class="flex items-start gap-4 pt-4 border-t border-gray-100">
            <div class="w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs text-gray-400 font-semibold uppercase">Email Korespondensi</span>
              <a href="mailto:kontak@pijatpanggilanpalembang.web.id" class="text-sm font-bold text-orange-600 hover:underline">
                kontak@pijatpanggilanpalembang.web.id
              </a>
            </div>
          </div>
        </div>

        <GoogleSourcePreferences />
      </div>

      <!-- Booking Form CTA Box -->
      <div class="bg-gradient-to-br from-orange-950 to-gray-900 text-white p-8 rounded-2xl shadow-xl space-y-6 border border-orange-700/50">
        <div class="space-y-2">
          <span class="inline-block bg-orange-500 text-white font-black text-[10px] uppercase px-3 py-1 rounded-full">
            Formulir Booking Cepat
          </span>
          <h3 class="text-xl font-bold text-white tracking-tight">Reservasi Mandiri Online</h3>
          <p class="text-xs text-orange-200 leading-relaxed">
            Gunakan sistem formulir booking kami agar pesanan Anda langsung tersimpan dan direspons oleh admin dengan pilihan dihubungi via WhatsApp, Telegram, atau Email:
          </p>
        </div>

        <div class="p-4 bg-white/10 rounded-xl text-xs space-y-2 border border-white/10">
          <div class="flex items-center gap-2">
            <span class="text-orange-400 font-bold">✓</span>
            <span>Pilih jenis layanan & durasi terapi</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-orange-400 font-bold">✓</span>
            <span>Tentukan preferensi terapis pria atau wanita</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-orange-400 font-bold">✓</span>
            <span>Gratis ongkos transport se-Kota Palembang</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-orange-400 font-bold">✓</span>
            <span>Tanpa uang muka (DP) — bayar pasca selesai</span>
          </div>
        </div>

        <a
          href="/booking/"
          class="w-full flex items-center justify-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-black text-sm py-4 rounded-xl shadow-lg transition-transform hover:scale-105"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Buka Formulir Booking Sekarang</span>
        </a>

        <div class="text-[11px] text-gray-400 text-center space-y-1">
          <p>✓ Bebas Uang Muka (Tanpa DP)</p>
          <p>✓ Pembayaran Pasca Terapi (Tunai / Transfer / QRIS)</p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
