---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`google-source-card bg-orange-50 border border-orange-200 rounded-xl p-4 my-6 text-sm ${className}`}>
  <div class="flex items-start gap-3">
    <div class="p-2 bg-orange-600 text-white rounded-lg shrink-0">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
      </svg>
    </div>
    <div class="flex-1">
      <h4 class="font-bold text-gray-900 mb-1">Jadikan Sumber Informasi Favorit di Google</h4>
      <p class="text-gray-600 mb-3 text-xs leading-relaxed">
        Dapatkan pembaruan tips kebugaran, panduan tarif terapis, dan promo pijat panggilan Palembang langsung di beranda Google Anda.
      </p>
      <a 
        href="https://www.google.com/preferences/source?source=pijatpanggilanpalembang.web.id" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 bg-orange-600 hover:bg-orange-700 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors"
      >
        <span>+ Ikuti di Google Search</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  function setupSourcePrefs() {
    const cards = document.querySelectorAll('.google-source-card');
    cards.forEach((card) => {
      // Event listener aktif untuk Astro View Transitions
    });
  }

  document.addEventListener('DOMContentLoaded', setupSourcePrefs);
  document.addEventListener('astro:page-load', setupSourcePrefs);
</script>
